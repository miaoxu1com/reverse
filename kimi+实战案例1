  使用流程（示例）

  # Frida 示例（动态插桩，常用于安全研究）
  import frida

  def on_message(message, data):
      print(f"[*] Hook 捕获: {message}")

  script = """
      // Hook WinHttpSendRequest
      var ptr = Module.getExportByName("winhttp.dll", "WinHttpSendRequest");

      Interceptor.attach(ptr, {
          onEnter: function(args) {
              console.log("[*] WinHttpSendRequest 被");

              // 获取 URL
              var url = this.hRequest.readUtf8String();
              console.log("[+] URL: " + url);
          }
      });
  """

  session = frida.attach("target.exe")
  script_obj = session.create_script(script)
  script_obj.on('message', on_message)
  script_obj.load()

